   "parms": {
    "za": 14,
    "zb": 42,
    "m1": 0.12,
    "alpha": -10,
    "zc": 16,
    "zd": 32,
    "m2": 0.18,
    "beta": 12,
    "ax": -4.0,
    "ay": 3.0,
    "ex": -4.6,
    "ey": 6.6,
    "bx": {
     "expr": "ch(\"ax\") + ch(\"m1\") * (ch(\"za\") + ch(\"zb\")) / 2 * cos((ch(\"alpha\")) * _pi / 180)"
    },
    "by": {
     "expr": "ch(\"ay\") + ch(\"m1\") * (ch(\"za\") + ch(\"zb\")) / 2 * sin((ch(\"alpha\")) * _pi / 180)"
    },
    "dx": {
     "expr": "ch(\"bx\") + ch(\"m2\") * (ch(\"zc\") + ch(\"zd\")) / 2 * cos((ch(\"beta\")) * _pi / 180)"
    },
    "dy": {
     "expr": "ch(\"by\") + ch(\"m2\") * (ch(\"zc\") + ch(\"zd\")) / 2 * sin((ch(\"beta\")) * _pi / 180)"
    },
    "run": {
     "expr": "max(0, $T - 4.5)"
    },
    "aa": {
     "expr": "396 * (ch(\"run\") - 1.5 * (1 - exp(-ch(\"run\") / 1.5)))"
    },
    "ab": {
     "expr": "-(ch(\"aa\") - 90 / ch(\"za\") - ch(\"alpha\")) * ch(\"za\") / ch(\"zb\") + ch(\"alpha\") + 180 - 90 / ch(\"zb\")"
    },
    "ad": {
     "expr": "-(ch(\"ab\") - 90 / ch(\"zc\") - ch(\"beta\")) * ch(\"zc\") / ch(\"zd\") + ch(\"beta\") + 180 - 90 / ch(\"zd\")"
    },
    "camr": 0.95,
    "camh": 0.55,
    "rollr": 0.22,
    "fy": {
     "expr": "ch(\"dy\") + ch(\"camr\") + ch(\"camh\") * ((1 + cos((90 - ch(\"ad\")) * _pi / 180)) / 2) * ((1 + cos((90 - ch(\"ad\")) * _pi / 180)) / 2) + ch(\"rollr\")"
    },
    "topy": {
     "expr": "ch(\"dy\") + 4.3"
    },
    "spring1": {
     "expr": "ch(\"topy\") - ch(\"fy\") - 1.32"
    },
    "crank": 0.7,
    "rod": 3.2,
    "pinx": {
     "expr": "ch(\"dx\") + ch(\"crank\") * cos((ch(\"ad\")) * _pi / 180)"
    },
    "piny": {
     "expr": "ch(\"dy\") + ch(\"crank\") * sin((ch(\"ad\")) * _pi / 180)"
    },
    "pistx": {
     "expr": "ch(\"pinx\") + sqrt(ch(\"rod\") * ch(\"rod\") - (ch(\"piny\") - ch(\"dy\")) * (ch(\"piny\") - ch(\"dy\")))"
    },
    "rodang": {
     "expr": "atan2(ch(\"dy\") - ch(\"piny\"), ch(\"pistx\") - ch(\"pinx\")) * 180 / _pi"
    },
    "spring2": {
     "expr": "ch(\"dx\") + 6 - ch(\"pistx\") - 0.55"
    },
    "bal": {
     "expr": "220 * (min(max(($T - 4.5) / 2, 0), 1) * min(max(($T - 4.5) / 2, 0), 1) * (3 - 2 * min(max(($T - 4.5) / 2, 0), 1))) * sin($T * 10.0531)"
    }
   }
